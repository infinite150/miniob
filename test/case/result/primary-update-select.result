init
CREATE TABLE upd_src(id int, v int);
SUCCESS
INSERT INTO upd_src VALUES (1, 100);
SUCCESS
CREATE TABLE upd_dst(id int, n int);
SUCCESS
INSERT INTO upd_dst VALUES (1, 0);
SUCCESS
INSERT INTO upd_dst VALUES (2, 0);
SUCCESS
INSERT INTO upd_dst VALUES (3, 0);
SUCCESS

multi-row UPDATE: SET from scalar subquery (same result per row)
UPDATE upd_dst SET n=(SELECT upd_src.v FROM upd_src WHERE upd_src.id=1);
SUCCESS
SELECT id, n FROM upd_dst;
1 | 100
2 | 100
3 | 100
ID | N

aggregate scalar subquery in SET
CREATE TABLE upd_cnt(id int);
SUCCESS
INSERT INTO upd_cnt VALUES (1);
SUCCESS
INSERT INTO upd_cnt VALUES (2);
SUCCESS
UPDATE upd_dst SET n=(SELECT COUNT(*) FROM upd_cnt) WHERE id<=2;
SUCCESS
SELECT id, n FROM upd_dst;
1 | 2
2 | 2
3 | 100
ID | N

regression: sequence update/select should not duplicate rows after failed subquery update
CREATE TABLE upd_seq(id int, n int);
SUCCESS
INSERT INTO upd_seq VALUES (1, 10);
SUCCESS
INSERT INTO upd_seq VALUES (2, 20);
SUCCESS
INSERT INTO upd_seq VALUES (2, 30);
SUCCESS
INSERT INTO upd_seq VALUES (3, 40);
SUCCESS
CREATE TABLE upd_seq_src(id int, v int);
SUCCESS
INSERT INTO upd_seq_src VALUES (1, 7);
SUCCESS
INSERT INTO upd_seq_src VALUES (1, 8);
SUCCESS
UPDATE upd_seq SET n=99 WHERE id=3;
SUCCESS
SELECT id, n FROM upd_seq;
1 | 10
2 | 20
2 | 30
3 | 99
ID | N
SELECT COUNT(*) FROM upd_seq;
COUNT(*)
4
UPDATE upd_seq SET n=(SELECT v FROM upd_seq_src WHERE upd_seq_src.id=1) WHERE id=2;
FAILURE
SELECT id, n FROM upd_seq;
1 | 10
2 | 20
2 | 30
3 | 99
ID | N
SELECT COUNT(*) FROM upd_seq;
COUNT(*)
4

regression: same-table scalar subquery UPDATE should read inner tuple values
CREATE TABLE upd_self(id int, name char(10), c2 int);
SUCCESS
INSERT INTO upd_self VALUES (1, 'AAA', 1);
SUCCESS
INSERT INTO upd_self VALUES (2, 'BBB', 2);
SUCCESS
UPDATE upd_self SET c2=(SELECT c2 FROM upd_self WHERE id=1) WHERE id=2;
SUCCESS
SELECT id, c2 FROM upd_self;
1 | 1
2 | 1
ID | C2
UPDATE upd_self SET name=(SELECT name FROM upd_self WHERE id=1) WHERE id=2;
SUCCESS
SELECT id, name, c2 FROM upd_self;
1 | AAA | 1
2 | AAA | 1
ID | NAME | C2
UPDATE upd_self SET name=(SELECT name FROM upd_self WHERE id=1), c2=(SELECT c2 FROM upd_self WHERE id=1) WHERE id=2;
SUCCESS
SELECT id, name, c2 FROM upd_self;
1 | AAA | 1
2 | AAA | 1
ID | NAME | C2
