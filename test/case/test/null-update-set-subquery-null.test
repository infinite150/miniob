-- echo init tables
CREATE TABLE null_table4(id int not null, num int null, name char(10) null);
INSERT INTO null_table4 VALUES (2, 2, 'N2');
INSERT INTO null_table4 VALUES (1, null, 'N1');

CREATE TABLE null_table3(id int not null, num int null, name char(10) null);
INSERT INTO null_table3 VALUES (9, null, null);

-- echo should succeed: update nullable column to NULL
UPDATE null_table4 SET name=null where num is null;

-- echo should fail: id is NOT NULL
UPDATE null_table4 SET id=null where num is null;

-- echo should succeed: scalar subquery returns NULL -> propagate into nullable target
UPDATE null_table4 SET num=(SELECT null_table3.num from null_table3 where null_table3.id=9) where id=1;

