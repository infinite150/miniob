-- echo init
CREATE TABLE upd_src(id int, v int);
INSERT INTO upd_src VALUES (1, 100);
CREATE TABLE upd_dst(id int, n int);
INSERT INTO upd_dst VALUES (1, 0);
INSERT INTO upd_dst VALUES (2, 0);
INSERT INTO upd_dst VALUES (3, 0);

-- echo multi-row UPDATE: SET from scalar subquery (same result per row)
UPDATE upd_dst SET n=(SELECT upd_src.v FROM upd_src WHERE upd_src.id=1);
-- sort SELECT id, n FROM upd_dst;

-- echo aggregate scalar subquery in SET
CREATE TABLE upd_cnt(id int);
INSERT INTO upd_cnt VALUES (1);
INSERT INTO upd_cnt VALUES (2);
UPDATE upd_dst SET n=(SELECT COUNT(*) FROM upd_cnt) WHERE id<=2;
-- sort SELECT id, n FROM upd_dst;

-- echo regression: scalar subquery returning >1 row must FAILURE (not crash); data unchanged
CREATE TABLE upd_seq(id int, n int);
INSERT INTO upd_seq VALUES (1, 10);
INSERT INTO upd_seq VALUES (2, 20);
INSERT INTO upd_seq VALUES (2, 30);
INSERT INTO upd_seq VALUES (3, 40);
CREATE TABLE upd_seq_src(id int, v int);
INSERT INTO upd_seq_src VALUES (1, 7);
INSERT INTO upd_seq_src VALUES (1, 8);
UPDATE upd_seq SET n=99 WHERE id=3;
-- sort SELECT id, n FROM upd_seq;
SELECT COUNT(*) FROM upd_seq;
UPDATE upd_seq SET n=(SELECT v FROM upd_seq_src WHERE upd_seq_src.id=1) WHERE id=2;
-- sort SELECT id, n FROM upd_seq;
SELECT COUNT(*) FROM upd_seq;

-- echo regression: duplicate key rows make scalar CHAR subquery multi-row; UPDATE must FAILURE
CREATE TABLE upd_scalar_dup_t1(id int, t_name char(10), c1 int, c2 int);
CREATE TABLE upd_scalar_dup_t2(id int, t_name char(10), c1 int, c2 int);
INSERT INTO upd_scalar_dup_t1 VALUES (7, 'WYXSZZC', 8, 2);
INSERT INTO upd_scalar_dup_t1 VALUES (7, 'QU', 5, 9);
INSERT INTO upd_scalar_dup_t2 VALUES (1, 'INIT', 0, 0);
UPDATE upd_scalar_dup_t2 SET t_name=(SELECT upd_scalar_dup_t1.t_name FROM upd_scalar_dup_t1 WHERE upd_scalar_dup_t1.id=7);
-- sort SELECT id, t_name, c1, c2 FROM upd_scalar_dup_t2;

-- echo regression: same-table scalar subquery UPDATE should read inner tuple values
CREATE TABLE upd_self(id int, name char(10), c2 int);
INSERT INTO upd_self VALUES (1, 'AAA', 1);
INSERT INTO upd_self VALUES (2, 'BBB', 2);
UPDATE upd_self SET c2=(SELECT c2 FROM upd_self WHERE id=1) WHERE id=2;
-- sort SELECT id, c2 FROM upd_self;
UPDATE upd_self SET name=(SELECT name FROM upd_self WHERE id=1) WHERE id=2;
-- sort SELECT id, name, c2 FROM upd_self;
UPDATE upd_self SET name=(SELECT name FROM upd_self WHERE id=1), c2=(SELECT c2 FROM upd_self WHERE id=1) WHERE id=2;
-- sort SELECT id, name, c2 FROM upd_self;

-- echo regression: CHAR from cross-table scalar subquery (Value copy must deep-copy string)
CREATE TABLE u_char_t1(id int, t_name char(10), c2 int);
CREATE TABLE u_char_t2(id int, t_name char(10), c2 int);
INSERT INTO u_char_t1 VALUES (8, 'SRCVAL', 1);
INSERT INTO u_char_t2 VALUES (1, 'x', 0);
UPDATE u_char_t2 SET t_name=(SELECT u_char_t1.t_name FROM u_char_t1 WHERE u_char_t1.id=8);
-- sort SELECT id, t_name, c2 FROM u_char_t2;
